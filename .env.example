# ARAKNO-AI Configuration
# Copy this file to .env and configure as needed.
# NEVER commit .env to version control.

# === LLM Configuration ===
# Provider: none | openrouter | gemini | ollama | nvidia
LLM_PROVIDER=none

# NVIDIA Nemotron / NIM (via integrate.api.nvidia.com)
# LLM_PROVIDER=nvidia
# LLM_API_KEY=nvapi-...
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# === Cost Protection ===
ALLOW_PAID_REQUESTS=false
REMOTE_LLM_FREE_ONLY=true

# === Privacy ===
ALLOW_REMOTE_MEDICAL_DATA=false

# === NCBI / PubMed ===
# NCBI requires an email for E-utilities. No API key needed for basic access.
NCBI_EMAIL=
NCBI_API_KEY=

# === Application ===
DATABASE_URL=sqlite:///./data/database/arakno.db
DATA_DIR=./data
HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# === Search Limits ===
PUBMED_MAX_RESULTS=50
EUROPEPMC_MAX_RESULTS=50
REQUEST_TIMEOUT=30
RATE_LIMIT_DELAY=0.34
